{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>digicatapult/renovate-config"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "description": "Container images in workflow input defaults. The digest is optional and the line is rebuilt, so docker:pinDigests can add one and tag and digest update together",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(scan-secrets|build-docker)\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\n(?<indentation>[ \\t]*)default: \"[^\"@]+:(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\""
      ],
      "autoReplaceStringTemplate": "# renovate: datasource=docker depName={{{depName}}}\n{{{indentation}}}default: \"{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\"",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/fallow-npm\\.yml$/",
        "/^\\.github/workflows/generate-sbom\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+default: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "{{{datasource}}}"
    },
    {
      "description": "SBOM tool versions in the generate-sbom inputs table, so README and workflow move in one PR per tool",
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "\\| (?:cyclonedx_npm|cdxgen)_version\\s+\\|[^|]+\\| Version of `(?<depName>[^`]+)`[^|]*\\| `(?<currentValue>[^`]+)`"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^examples/fallow-npm\\.md$/"
      ],
      "matchStrings": [
        "\\| fallow_version\\s+\\|[^|]+\\|[^|]+\\| `(?<currentValue>[^`]+)`",
        "npx fallow@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "fallow_version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "fallow",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/scan-vulns\\.yml$/",
        "/^\\.github/workflows/scan-post-quantum-cryptography\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases|pypi) depName=(?<depName>\\S+)\\s+[A-Z_]+: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "{{{datasource}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/scan-post-quantum-cryptography\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=git-refs depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\s+[A-Z_]+: \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Bump Semgrep in scan-vulns and scan-post-quantum-cryptography together",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["semgrep"],
      "groupName": "semgrep"
    },
    {
      "description": "Asset SHA256s cannot be updated automatically; the reviewer must copy them from the release checksums.txt",
      "matchPackageNames": ["csnp/cryptoscan"],
      "prBodyNotes": ["Update `CRYPTOSCAN_SHA256` in `scan-post-quantum-cryptography.yml` from this release's `checksums.txt` before merging; the install step fails until it is updated."]
    },
    {
      "description": "cyclonedx-npm 7 drops the optional dependencies that XML output and BOM validation need",
      "matchPackageNames": ["@cyclonedx/cyclonedx-npm"],
      "matchCurrentVersion": "<7.0.0",
      "matchUpdateTypes": ["major"],
      "prBodyNotes": ["From 7.0.0, `--output-format XML` and BOM validation need optional peer dependencies that `npx` does not install, so check callers using `sbom_format: xml` before merging. 7.0.0 also defaults to CycloneDX 1.7; the `spec_version` input keeps uploads at 1.6, which is the newest Dependency-Track 5.0.x accepts."]
    }
  ]
}
